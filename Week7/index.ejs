<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>

    <style>
        .error {
            color: red;
        }
    </style>
</head>

<body>

    <h1><%= title %></h1>

    <% if (error) { %>
        <p class="error"><%= error %></p>
    <% } %>

    <% if (user) { %>
        <p>Welcome, <%= user %>!</p>
    <% } else { %>

        <form action="/register" method="POST">

            <p>
                <label>Username:</label>
                <input type="text" name="username">
            </p>

            <p>
                <label>Age:</label>
                <input type="number" name="age">
            </p>

            <button type="submit">Register</button>

        </form>

    <% } %>

</body>
</html> 
